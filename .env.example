# NEXUSCRAFT Control Plane
PORT=3000
PUBLIC_URL=http://localhost:3000
# Local Node-Agent defaults (single-node mode)
AGENT_URL=http://127.0.0.1:3100
AGENT_TOKEN=

# CurseForge: request an API key from CurseForge before enabling CurseForge modpack installs
CURSEFORGE_API_KEY=

# Stripe: use test keys first; configure webhook endpoint https://panel.example.com/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NEXUSCRAFT <noreply@example.com>

# On a remote node, agent may bind to loopback behind Caddy
AGENT_HOST=127.0.0.1
AGENT_PORT=3100
